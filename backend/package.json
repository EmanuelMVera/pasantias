{
  "name": "sistema-pasantias-backend",
  "version": "1.0.0",
  "description": "API REST del Sistema de Gestión de Pasantías",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:seed:admin": "node src/utils/seedAdmin.js",
    "db:seed:demo": "node src/utils/seedDemo.js",
    "db:migrate": "node scripts/migrate.js up",
    "db:migrate:down": "node scripts/migrate.js down",
    "db:migrate:status": "node scripts/migrate.js status",
    "db:migrate:create": "node scripts/migrate.js create",
    "db:backup": "node scripts/db-backup.js",
    "db:schema:dump": "node src/utils/dumpSchema.js",
    "db:reset:dev": "node src/utils/resetDev.js",
    "db:backfill:archivos": "node src/utils/backfillArchivos.js",
    "logs:archivar": "node src/utils/archivarActivityLogs.js",
    "e2e:seed": "node scripts/seed-e2e.js",
    "docs:openapi": "node scripts/generate-openapi.js",
    "docs:check": "node scripts/generate-openapi.js && git diff --exit-code openapi.json",
    "test": "jest --runInBand"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.3",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sequelize": "^6.37.8",
    "swagger-ui-express": "^5.0.1",
    "umzug": "^3.8.3"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2"
  }
}
