# ── Backend ───────────────────────────────────────────────────────────────────
# Copiar a `backend/.env` (gitignored) y completar.
# Para DESARROLLO LOCAL alcanza con ajustar DB_PASSWORD; el resto de los defaults
# sirve tal cual. Las variables marcadas "(prod)" son obligatorias en producción
# (el server aborta al arrancar si faltan — src/config/env.js).
#
# Guía de despliegue completa: docs/DEPLOYMENT.md

NODE_ENV=development
# PORT: en local, 5000. En Render NO se setea (la plataforma inyecta PORT).
PORT=5000

# ── Base de datos ─────────────────────────────────────────────────────────────
# Precedencia: si DATABASE_URL está definida se usa esa; si no, DB_HOST/PORT/
# NAME/USER/PASSWORD. Las migraciones usan la MISMA conexión que la app.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pasantias_db
DB_USER=postgres
DB_PASSWORD=tu_password
# (prod) Connection string única. En Neon: usar la variante *pooled*
#   postgresql://user:pass@ep-xxx-pooler.<region>.aws.neon.tech/dbname?sslmode=require
# DATABASE_URL=

# SSL de la conexión. true|false. Vacío → ON en producción (y si la URL trae
# sslmode=require o si PGSSLMODE=require). Neon EXIGE TLS.
DB_SSL=
# Opt-in inseguro: NO verificar el certificado del servidor. Solo para un
# proveedor con cert self-signed; Neon tiene cert válido → dejar sin setear.
# DB_SSL_NO_VERIFY=true
# Máximo de conexiones del pool. Default 5 (prudente para Render chico + el
# pooler de Neon). Subir solo si el plan de Neon lo permite.
DB_POOL_MAX=5

# Base usada por la suite de tests (Jest). Si no se define, se usa `${DB_NAME}_test`.
# La crea y migra automáticamente tests/setup/ al correr `npm test`.
# DB_NAME_TEST=pasantias_db_test
# `pg_dump` / `pg_restore` deben estar en PATH para `npm run db:backup` y
# `npm run db:schema:dump` (vienen en bin/ de PostgreSQL).

# ── JWT ───────────────────────────────────────────────────────────────────────
# (prod) Secreto de firma del JWT de sesión. Largo y aleatorio (>= 32 chars).
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# En producción usar uno NUEVO, distinto del de desarrollo.
JWT_SECRET=tu_jwt_secret_muy_seguro_aqui_min_32_chars
JWT_EXPIRES_IN=7d

# ── Cookie de sesión (SEC-02: el JWT va en cookie HttpOnly) ───────────────────
# Con el proxy de Vercel (/api/* → Render) el navegador ve la API como
# same-origin → SameSite=lax alcanza. `none` solo si el frontend llama a la API
# en otro dominio sin proxy (requiere COOKIE_SECURE=true).
COOKIE_SAMESITE=lax
# Vacío = true en producción (o si SameSite=none). 'false' solo para dev sin HTTPS.
COOKIE_SECURE=
# Dejar VACÍO con el proxy same-origin. Solo setear (ej: .miuni.edu) si front y
# back son subdominios de un mismo dominio registrable.
COOKIE_DOMAIN=

# ── CORS / red ───────────────────────────────────────────────────────────────
# (prod) URL pública del FRONTEND. Se usa para links de emails (recupero,
# aprobaciones) y como fallback de CORS. HTTPS en producción.
CLIENT_URL=http://localhost:5173
# (prod) Orígenes permitidos por CORS, separados por coma, sin barra final, sin
# comodín "*". Si no se define, se usa CLIENT_URL. Con el proxy de Vercel el
# navegador no manda Origin; esto cubre dev directo, server-to-server y un
# eventual dominio propio del frontend.
ALLOWED_ORIGINS=http://localhost:5173
# (prod si STORAGE_BACKEND=local) URL pública del BACKEND. Con STORAGE_BACKEND=s3
# no es obligatoria (las imágenes salen de S3_PUBLIC_BASE_URL). HTTPS en prod.
PUBLIC_URL=
# Nº de reverse proxies delante del backend. En Render: 1. Dejar VACÍO si el
# backend recibe tráfico directo (setearlo permitiría spoofear la IP del cliente).
TRUST_PROXY=
# Habilita orígenes *.trycloudflare.com (solo demos; ignorado en producción).
ALLOW_TUNNEL_ORIGINS=false
# Techo global de requests por IP cada 15 min (ceiling anti-abuso).
API_RATE_MAX=1000
# Techo de intentos de login por IP cada 15 min.
AUTH_IP_RATE_MAX=40

# ── Almacenamiento de archivos (DEPLOY-01) ──────────────────────────────────
# local → filesystem (backend/uploads/). Default. Para dev y tests.
# s3    → S3-compatible (AWS S3 / Cloudflare R2). Para producción (el disco de
#         Render es efímero). Requiere TODAS las S3_* de abajo.
STORAGE_BACKEND=local
# Endpoint S3. En Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
# Región. R2: "auto". AWS: us-east-1, etc.
S3_REGION=auto
# Bucket PRIVADO (CV, cartas). NO debe tener acceso público.
S3_BUCKET=
# Bucket PÚBLICO (fotos de perfil, logos). Con acceso de lectura público.
S3_PUBLIC_BUCKET=
# Credenciales (un token con acceso a los dos buckets).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true solo si el proveedor lo necesita (path-style). R2/AWS: false.
S3_FORCE_PATH_STYLE=false
# URL pública base del bucket PÚBLICO (dominio r2.dev o dominio propio de R2).
# Sin barra final. Ej: https://cdn.tudominio.edu   o   https://pub-xxxx.r2.dev
S3_PUBLIC_BASE_URL=
# Prefijo de las keys en los buckets (namespacing).
S3_KEY_PREFIX=sispasantias

# ── Email (Nodemailer) ──────────────────────────────────────────────────────
# Dejar EMAIL_USER/EMAIL_PASS vacíos y la API arranca igual: los links de
# recuperación se devuelven en la respuesta JSON SOLO fuera de producción.
# En producción, sin SMTP, el usuario simplemente no recibe el email (nunca se
# filtra el token).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
# true → TLS implícito (puerto 465). Default false → STARTTLS (587, Gmail).
EMAIL_SECURE=false
EMAIL_USER=
# Gmail: es una "contraseña de aplicación" (App Password), NO la del correo.
EMAIL_PASS=
# Remitente del email. Default: "SisPasantías" <EMAIL_USER>. Setear si el
# usuario SMTP no es una dirección válida (ej. API keys de SendGrid/Mailgun).
# EMAIL_FROM="SisPasantías" <noreply@tudominio.edu>
# Si =true, la API ABORTA al arrancar si falta EMAIL_USER/EMAIL_PASS.
EMAIL_REQUIRED=false

# ── Seed del admin ──────────────────────────────────────────────────────────
# (prod) Obligatorios: `npm run db:seed:admin` aborta en producción si faltan.
# En dev, si están vacíos se crea admin@pasantias.com / Admin1234!.
# El seed es idempotente (no duplica) → seguro correrlo varias veces.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── Escenario de demo para la presentación ─────────────────────────────────
# Al arrancar el server, si el escenario (usuarios *@demo.com + empresa demo)
# no está cargado, se siembra solo. Vacío → ON solo en NODE_ENV=development.
# En producción NUNCA (aunque esté en true) salvo ALLOW_PRODUCTION_DEMO_SEED=true.
SEED_PRESENTACION_ON_BOOT=false
# Doble confirmación para correr db:seed:presentacion en producción (crea datos
# ficticios). Sin esto, el script aborta si NODE_ENV=production.
ALLOW_PRODUCTION_DEMO_SEED=false

# ── Observabilidad (OPS-01) ────────────────────────────────────────────────
# debug | info | warn | error | fatal | silent
# Vacío = debug en dev, info en prod, silent en tests. debug también logea el SQL.
LOG_LEVEL=
# Retención de activity_logs (en días) antes de archivar con `npm run logs:archivar`.
ACTIVITY_LOG_RETENTION_DAYS=365

# ── Documentación de la API (DOC-02) ──────────────────────────────────────
# Swagger UI en /api/docs + spec en /api/openapi.json.
#   vacío + NODE_ENV=production → OFF   ·   vacío + no-prod → ON
#   true → fuerza ON   ·   false → fuerza OFF
ENABLE_API_DOCS=

# Nota: SEC_TESTS=1 lo setea internamente tests/seguridad.test.js. No va acá.
