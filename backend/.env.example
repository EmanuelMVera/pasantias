# ── Backend ───────────────────────────────────────────────────────────────────
# Copiar a `backend/.env` (gitignored) y completar.
# Para DESARROLLO LOCAL alcanza con ajustar DB_PASSWORD; el resto de los defaults
# sirve tal cual. Las variables marcadas "(prod)" son obligatorias en producción.

NODE_ENV=development
PORT=5000

# ── Base de datos ─────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pasantias_db
DB_USER=postgres
DB_PASSWORD=tu_password
# Base usada por la suite de tests (Jest). Si no se define, se usa `${DB_NAME}_test`.
# La crea y migra automáticamente tests/setup/ al correr `npm test`.
# DB_NAME_TEST=pasantias_db_test
# `pg_dump` y `pg_restore` deben estar en PATH para `npm run db:backup` y
# `npm run db:schema:dump` (vienen en la carpeta bin/ de PostgreSQL).

# ── JWT ───────────────────────────────────────────────────────────────────────
# (prod) Secreto de firma del JWT de sesión. Largo y aleatorio.
JWT_SECRET=tu_jwt_secret_muy_seguro_aqui
JWT_EXPIRES_IN=7d

# ── Cookie de sesión (SEC-02: el JWT va en cookie HttpOnly) ───────────────────
# lax  → front y back son same-site (mismo dominio registrable). Recomendado.
# none → front y back en dominios distintos; REQUIERE COOKIE_SECURE=true (HTTPS).
COOKIE_SAMESITE=lax
# Vacío = true en producción. 'false' solo para dev local sin HTTPS.
COOKIE_SECURE=
# Ej: .itb.edu  si front (app.itb.edu) y back (api.itb.edu) son subdominios.
COOKIE_DOMAIN=

# ── Email (Nodemailer / Gmail) ────────────────────────────────────────────────
# Dejar EMAIL_USER/EMAIL_PASS vacíos y el sistema funciona igual: los links de
# activación/recuperación se devuelven en la respuesta JSON en vez de mandarse.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# ── CORS / red (SEC-02) ──────────────────────────────────────────────────────
# URL del frontend: se usa para armar links en emails y como fallback de CORS.
CLIENT_URL=http://localhost:5173
# (prod) Orígenes permitidos por CORS, separados por coma. Si no se define, se usa CLIENT_URL.
ALLOWED_ORIGINS=http://localhost:5173
# Habilita orígenes *.trycloudflare.com (solo demos; ignorado en producción).
ALLOW_TUNNEL_ORIGINS=false
# Nº de reverse proxies delante del backend (Cloudflare Tunnel/nginx = 1).
# Dejar VACÍO si el backend recibe tráfico directo (setearlo permitiría spoofear la IP).
TRUST_PROXY=
# URL pública del backend, para armar las URLs absolutas de avatares/logos
# (/uploads/public/...). Vacío = se deriva de la request.
PUBLIC_URL=
# Techo global de requests por IP cada 15 min (ceiling anti-abuso).
API_RATE_MAX=1000

# ── Seed del admin (SEC-02) ──────────────────────────────────────────────────
# (prod) Obligatorios: `npm run db:seed:admin` aborta en producción si faltan.
# En dev, si están vacíos se crea admin@pasantias.com / Admin1234!.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── Observabilidad (OPS-01) ─────────────────────────────────────────────────
# Nivel del log técnico: debug | info | warn | error | fatal | silent
# Vacío = debug en dev, info en prod, silent en tests. LOG_LEVEL=debug también
# habilita el log del SQL de Sequelize.
LOG_LEVEL=
# Retención de activity_logs (en días) antes de archivar con `npm run logs:archivar`.
ACTIVITY_LOG_RETENTION_DAYS=365

# Nota: SEC_TESTS=1 lo setea internamente tests/seguridad.test.js para ejercitar
# rate limiting y CSRF (normalmente desactivados en NODE_ENV=test). No va acá.
