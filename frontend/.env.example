# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Copiar a `.env` solo si hace falta sobrescribir el default. En desarrollo local
# NO es necesario: si esta variable no está, src/services/api.js usa
# http://localhost:5000/api (y vite.config.js proxea /api al backend local).
#
# Solo se leen variables con prefijo VITE_ y quedan EMBEBIDAS en el bundle
# (visibles públicamente). NUNCA poner secretos acá.

# URL base de la API del backend, INCLUYENDO el prefijo /api.
#   dev  : http://localhost:5000/api   (default si se omite)
#   prod : /api                        (Vercel proxea /api/* al backend de Render
#                                       vía frontend/vercel.json → same-origin,
#                                       la cookie de sesión y el CSRF funcionan)
VITE_API_URL=http://localhost:5000/api
